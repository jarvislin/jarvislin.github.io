---
import { achievements, localize } from '../data/resume';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const items = achievements.map(a => localize(a, lang));
---

<section id="achievements" class="px-4 mt-8">
  <div class="mx-auto w-full max-w-content">
    <h2 class="text-headline-md text-on-surface text-center mb-4">{t.headings.achievements}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
      {items.map(achievement => (
        <button
          class="achievement-card state card reveal text-left cursor-pointer"
          data-id={achievement.id}
          aria-label={t.achievementAria(achievement.title)}
        >
          <img
            src={achievement.image}
            alt={achievement.title}
            class="w-full object-cover rounded-t-shape-md"
            style="aspect-ratio:16/9"
            loading="lazy"
          />
          <div class="p-4 flex-1">
            <h3 class="text-title-md text-on-surface mb-2">{achievement.title}</h3>
            <p class="text-body-md text-on-surface-variant leading-relaxed">{achievement.description}</p>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Achievement dialogs -->
{items.map(achievement => (
  <dialog id={`achievement-dialog-${achievement.id}`} aria-label={achievement.title} class="w-full max-w-lg rounded-shape-xl">
    <div class="card card-xl bg-surface-container p-0 relative">
      <img
        src={achievement.image}
        alt={achievement.title}
        class="w-full object-cover rounded-t-shape-md"
        style="aspect-ratio:16/10"
      />
      <button
        class="close-achievement-btn tap state absolute top-3 left-3 w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface"
        aria-label={t.dismiss}
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
      <div class="p-4 space-y-3 max-h-64 overflow-y-auto">
        {achievement.paragraphs.map(p => (
          <p class="text-body-md text-on-surface leading-relaxed">{p}</p>
        ))}
      </div>
    </div>
  </dialog>
))}

<script>
  document.querySelectorAll<HTMLButtonElement>('.achievement-card').forEach(card => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-id');
      const dialog = document.getElementById(`achievement-dialog-${id}`) as HTMLDialogElement;
      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.close-achievement-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      (btn.closest('dialog') as HTMLDialogElement)?.close();
    });
  });

  document.querySelectorAll('dialog').forEach(dialog => {
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  });
</script>
