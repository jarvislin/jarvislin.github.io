---
import { profile, localize } from '../data/resume';
import { iconSvgs } from '../lib/icons';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const p = localize(profile, lang);
const links = p.links.map(l => localize(l, lang));
---

<section id="about" class="px-4 pt-16 md:pt-24">
  <div class="mx-auto w-full max-w-content">
  <!-- Desktop layout -->
  <div class="card hidden md:flex w-full overflow-hidden" style="max-height:360px">
    <img
      src={p.avatar}
      alt={p.name}
      class="object-cover rounded-xl flex-shrink-0"
      style="aspect-ratio:3/4; max-height:360px; width:auto;"
    />
    <div class="flex flex-col justify-center px-10 py-8 flex-1 min-w-0">
      <h1 class="text-5xl font-bold tracking-tight text-on-surface">{p.name}</h1>
      <p class="text-xl text-on-surface-variant mt-2">{p.title}</p>

      <div class="mt-6 space-y-2">
        <a href={`mailto:${p.email}`} class="tap flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors">
          <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <span class="text-sm">{p.email}</span>
        </a>
        <div class="flex items-center gap-2 text-on-surface-variant">
          <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="text-sm">{p.location}</span>
        </div>
        <div class="flex items-start gap-2 text-on-surface-variant">
          <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
          <span class="text-sm">{p.education}</span>
        </div>
      </div>

      <hr class="my-4 border-outline-variant" />

      <div class="flex gap-3">
        {links.map(link => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="tap w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center text-on-surface-variant hover:text-primary hover:border-primary transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvgs[link.icon]} />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Mobile layout -->
  <div class="card md:hidden w-full overflow-hidden">
    <img src={p.avatar} alt={p.name} class="w-full rounded-xl object-cover" style="aspect-ratio:16/9" />
    <div class="px-4 pt-3 pb-2 space-y-2">
      <h1 class="text-3xl font-bold tracking-tight text-on-surface">{p.name}</h1>
      <p class="text-lg text-on-surface-variant">{p.title}</p>
      <a href={`mailto:${p.email}`} class="tap flex items-center gap-2 text-on-surface-variant">
        <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        <span class="text-sm">{p.email}</span>
      </a>
      <div class="flex items-center gap-2 text-on-surface-variant">
        <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span class="text-sm">{p.location}</span>
      </div>
      <div class="flex items-start gap-2 text-on-surface-variant">
        <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
          <path d="M6 12v5c3 3 9 3 12 0v-5"/>
        </svg>
        <span class="text-sm">{p.education}</span>
      </div>
    </div>
    <hr class="border-outline-variant mx-4" />
    <div class="flex gap-2 px-4 pt-2 pb-3">
      {links.map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
          class="tap w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center text-on-surface-variant hover:text-primary hover:border-primary transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvgs[link.icon]} />
        </a>
      ))}
    </div>
  </div>
  </div>
</section>
