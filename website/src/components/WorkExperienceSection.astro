---
import { workExperiences, localize } from '../data/resume';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const items = workExperiences.map(e => localize(e, lang));

type Exp = typeof items[0];
const pairs: [Exp, Exp | null][] = [];
for (let i = 0; i < items.length; i += 2) {
  pairs.push([items[i], items[i + 1] ?? null]);
}

const INITIAL_COUNT = 4;
const initialPairCount = Math.ceil(INITIAL_COUNT / 2);
const hasMore = items.length > INITIAL_COUNT;
---

<section id="experiences" class="px-4 mt-8">
  <div class="mx-auto w-full max-w-content">
    <h2 class="text-headline-md text-on-surface text-center mb-4">{t.headings.experiences}</h2>

    <!-- Mobile layout: single column -->
    <div class="flex flex-col items-center gap-0 md:hidden">
      {items.map((exp, i) => (
        <div class="work-item w-full flex flex-col items-center" data-idx={i} style={i < INITIAL_COUNT ? '' : 'display:none'}>
          <div class="card reveal w-full overflow-hidden">
            <div class="h-2 bg-primary w-full"></div>
            <div class="p-4">
              {exp.duration && <p class="text-label-md text-primary">{exp.duration}</p>}
              {exp.title && <p class="text-title-md text-on-surface mt-1">{exp.title}</p>}
              {exp.company && <p class="text-body-lg text-on-surface">{exp.company}</p>}
              {exp.description && (
                <div class="mt-3 space-y-2">
                  {exp.description.split('\n\n').map(para => (
                    <p class="text-body-md text-on-surface-variant leading-relaxed">{para}</p>
                  ))}
                </div>
              )}
            </div>
          </div>
          {i < items.length - 1 && (
            <div class="w-0.5 h-4 bg-secondary-container"></div>
          )}
        </div>
      ))}
    </div>

    <!-- Desktop layout: pair-based rows, right card offset for stagger -->
    <div class="hidden md:block relative">
      <!-- Center line: JS will set top/height to span exactly first→last dot -->
      <div id="work-timeline-line" class="absolute left-1/2 -translate-x-1/2 w-0.5 bg-secondary-container z-0"></div>

      <div class="flex flex-col gap-6">
        {pairs.map(([leftExp, rightExp], pairIdx) => (
          <div class="work-row grid grid-cols-2 gap-6 items-start" data-pair-idx={pairIdx} style={pairIdx < initialPairCount ? '' : 'display:none'}>

            <!-- Left card -->
            <div class="relative reveal">
              <div class="card overflow-hidden">
                <div class="h-2 bg-primary w-full"></div>
                <div class="p-4">
                  {leftExp.duration && <p class="text-label-md text-primary">{leftExp.duration}</p>}
                  {leftExp.title && <p class="text-title-md text-on-surface mt-1">{leftExp.title}</p>}
                  {leftExp.company && <p class="text-body-lg text-on-surface">{leftExp.company}</p>}
                  {leftExp.description && (
                    <div class="mt-3 space-y-2">
                      {leftExp.description.split('\n\n').map(para => (
                        <p class="text-body-md text-on-surface-variant leading-relaxed">{para}</p>
                      ))}
                    </div>
                  )}
                </div>
              </div>
              <div class="work-dot absolute right-0 top-6 translate-x-[18px] z-10 w-3 h-3 rounded-full bg-primary ring-2 ring-surface"></div>
            </div>

            <!-- Right card: pt-8 creates the stagger offset within the shared row -->
            <div class="pt-8 reveal">
              {rightExp && (
                <div class="relative">
                  <div class="work-dot absolute left-0 top-6 -translate-x-[18px] z-10 w-3 h-3 rounded-full bg-primary ring-2 ring-surface"></div>
                  <div class="card overflow-hidden">
                    <div class="h-2 bg-primary w-full"></div>
                    <div class="p-4">
                      {rightExp.duration && <p class="text-label-md text-primary">{rightExp.duration}</p>}
                      {rightExp.title && <p class="text-title-md text-on-surface mt-1">{rightExp.title}</p>}
                      {rightExp.company && <p class="text-body-lg text-on-surface">{rightExp.company}</p>}
                      {rightExp.description && (
                        <div class="mt-3 space-y-2">
                          {rightExp.description.split('\n\n').map(para => (
                            <p class="text-body-md text-on-surface-variant leading-relaxed">{para}</p>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              )}
            </div>

          </div>
        ))}
      </div>
    </div>

    {hasMore && (
      <div class="flex justify-center mt-6">
        <button
          id="work-show-more-btn"
          class="tap state px-6 py-2.5 border border-primary text-primary text-label-lg rounded-full"
        >
          {t.showFullExperience}
        </button>
      </div>
    )}

  </div>
</section>

<script>
  function positionTimelineLine() {
    const line = document.getElementById('work-timeline-line');
    // Hidden rows still match .work-dot; only measure ones actually laid out.
    const dots = Array.from(document.querySelectorAll<HTMLElement>('.work-dot')).filter(d => d.offsetParent !== null);
    if (!line || dots.length === 0) return;

    const container = line.parentElement!;
    const containerTop = container.getBoundingClientRect().top + window.scrollY;
    const firstDotRect = dots[0].getBoundingClientRect();
    const lastDotRect = dots[dots.length - 1].getBoundingClientRect();

    const top = firstDotRect.top + window.scrollY + firstDotRect.height / 2 - containerTop;
    const bottom = lastDotRect.top + window.scrollY + lastDotRect.height / 2 - containerTop;

    line.style.top = `${top}px`;
    line.style.height = `${bottom - top}px`;
  }

  positionTimelineLine();
  window.addEventListener('resize', positionTimelineLine);

  document.getElementById('work-show-more-btn')?.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLElement>('.work-item, .work-row').forEach(el => { el.style.display = ''; });
    (e.currentTarget as HTMLElement).closest('div')!.style.display = 'none';
    positionTimelineLine();
    // Re-measure once the newly revealed cards finish their reveal transition.
    setTimeout(positionTimelineLine, 550);
  });
</script>
