---
import { profile } from '../data/resume';
import { iconSvgs } from '../lib/icons';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-outline-variant">
  <div class="px-4 py-10">
    <div class="mx-auto w-full max-w-content flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <p class="text-lg font-bold text-on-surface">{profile.name}</p>
        <p class="text-sm text-on-surface-variant mt-1">{profile.title}</p>
      </div>
      <div class="flex gap-3">
        {profile.links.map(link => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="w-9 h-9 rounded-full border border-outline-variant flex items-center justify-center text-on-surface-variant hover:text-primary hover:border-primary transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvgs[link.icon]} />
          </a>
        ))}
      </div>
    </div>
    <div class="mx-auto w-full max-w-content mt-8 pt-6 border-t border-outline-variant flex flex-col-reverse md:flex-row items-center justify-between gap-2 text-xs text-on-surface-variant">
      <p>&copy; {year} {profile.name}. All rights reserved.</p>
      <a href="#about" class="hover:text-primary transition-colors">Back to top ↑</a>
    </div>
  </div>
</footer>
