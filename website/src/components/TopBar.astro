---
import { ui, langPath, htmlLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'zh' : 'en';
const navItems = [
  { label: t.nav.about, href: '#about' },
  { label: t.nav.skills, href: '#skills' },
  { label: t.nav.achievements, href: '#achievements' },
  { label: t.nav.projects, href: '#projects' },
  { label: t.nav.experiences, href: '#experiences' },
  { label: t.nav.references, href: '#references' },
  { label: t.nav.contact, href: '#contact' },
];
---

<header class="sticky top-0 z-50 border-b border-outline-variant bg-secondary-container">
  <nav class="max-w-[1200px] mx-auto px-4 h-14 flex items-center gap-2">
    <!-- Logo -->
    <img src="/images/logo.webp" alt="JL" class="logo-tinted h-8 w-auto flex-shrink-0" />

    <div class="flex-1"></div>

    <!-- Desktop nav -->
    <div id="desktop-nav" class="hidden lg:flex items-center">
      {navItems.map(item => (
        <a
          href={item.href}
          class="nav-link inline-flex items-center min-h-12 px-3 text-label-lg text-on-secondary-container"
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Theme toggle -->
    <button
      id="theme-toggle"
      onclick="window.toggleTheme()"
      aria-label={t.themeToLight}
      data-to-light={t.themeToLight}
      data-to-dark={t.themeToDark}
      class="tap state ml-2 p-2.5 rounded-full text-on-secondary-container"
    >
      <svg id="icon-sun" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/>
        <line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/>
        <line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <svg id="icon-moon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>

    <!-- Language toggle: a real link to the other language page, so it works without JS -->
    <a
      id="lang-toggle"
      href={langPath[other]}
      hreflang={htmlLang[other]}
      lang={htmlLang[other]}
      data-lang={other}
      aria-label={t.langToggle.aria}
      class="tap state ml-1 px-3 py-1.5 rounded-full text-label-lg text-on-secondary-container"
    >
      {t.langToggle.label}
    </a>
    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      aria-haspopup="dialog"
      class="tap lg:hidden ml-1 px-3 py-1.5 border border-on-secondary-container rounded-full text-label-lg text-on-secondary-container"
    >
      {t.menu}
    </button>
  </nav>
</header>

<!-- Mobile nav dialog -->
<!-- Mobile nav: modal navigation drawer -->
<dialog id="mobile-menu-dialog" aria-labelledby="mobile-menu-title" class="drawer-dialog">
  <div class="drawer flex flex-col">
    <p id="mobile-menu-title" class="text-title-sm text-on-surface-variant px-4 py-4">{t.navigateTo}</p>
    <nav class="flex flex-col">
      {navItems.map(item => (
        <a
          href={item.href}
          class="mobile-nav-link state flex items-center min-h-14 px-4 rounded-full text-label-lg text-on-surface-variant"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex justify-end mt-auto">
      <button id="close-mobile-menu" class="tap state rounded-full text-label-lg text-primary px-3 py-2">{t.dismiss}</button>
    </div>
  </div>
</dialog>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const dialog = document.getElementById('mobile-menu-dialog') as HTMLDialogElement;
  const closeBtn = document.getElementById('close-mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  btn?.addEventListener('click', () => dialog?.showModal());
  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  mobileLinks.forEach(link => link.addEventListener('click', () => dialog?.close()));

  // Remember the chosen language and keep the current section when switching
  const langToggle = document.getElementById('lang-toggle') as HTMLAnchorElement | null;
  langToggle?.addEventListener('click', () => {
    try { localStorage.setItem('lang', langToggle.dataset.lang ?? 'en'); } catch {}
    langToggle.href = langToggle.getAttribute('href')!.split('#')[0] + location.hash;
  });

  // Sync theme icon
  function syncThemeIcon() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    (document.getElementById('icon-sun') as HTMLElement).classList.toggle('hidden', isDark);
    (document.getElementById('icon-moon') as HTMLElement).classList.toggle('hidden', !isDark);
    const toggle = document.getElementById('theme-toggle')!;
    toggle.setAttribute('aria-label', (isDark ? toggle.dataset.toLight : toggle.dataset.toDark) ?? '');
  }
  syncThemeIcon();

  // Active nav highlight on scroll
  const sections = ['about', 'skills', 'achievements', 'projects', 'experiences', 'references', 'contact'];
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link, .mobile-nav-link');

  function setActive(id: string) {
    navLinks.forEach(link => {
      const isActive = link.getAttribute('href') === `#${id}`;
      if (isActive) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }

  // Default: highlight first section on load
  setActive('about');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
        }
      });
    },
    { rootMargin: '-20% 0px -60% 0px' }
  );

  sections.forEach(id => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // Watch for theme changes to update icon
  const themeObserver = new MutationObserver(syncThemeIcon);
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
